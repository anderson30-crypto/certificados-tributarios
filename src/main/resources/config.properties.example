# =====================================================================
# Configuración del aplicativo. NINGÚN dato sensible va en el código.
#
# En el PC (desarrollo): copiar este archivo como config.properties en esta misma
# carpeta y poner los datos reales. config.properties NO se sube a git.
#
# En el servidor (Red Hat): no usar este archivo dentro del proyecto. Definir las
# variables de entorno indicadas en cada clave (por ejemplo CT_DB_PASSWORD) o
# apuntar CT_CONFIG a un archivo externo protegido, por ejemplo:
#   CT_CONFIG=/etc/certificados-tributarios/config.properties   (permisos 600)
# Las variables de entorno tienen prioridad sobre los archivos.
# =====================================================================

# --- Base de datos ---
# CT_DB_URL
url=jdbc:mysql://localhost:3306/certificados_tributarios
# CT_DB_USUARIO
usuario=root
# CT_DB_PASSWORD
password=TU_PASSWORD

# --- Correo (Office 365 de la universidad) ---
# CT_CORREO_HOST
correo.host=smtp.office365.com
# CT_CORREO_PUERTO
correo.puerto=587
# CT_CORREO_USUARIO
correo.usuario=cuenta@upb.edu.co
# CT_CORREO_PASSWORD  (contraseña de aplicación, no la de la cuenta)
correo.password=CONTRASENA_DE_APLICACION
# CT_CORREO_STARTTLS  (Office 365 exige cifrado STARTTLS en el puerto 587)
correo.starttls=true
# CT_CORREO_PAUSA_MS  (pausa entre correos para respetar los límites de Exchange)
correo.pausa_ms=2500
# CT_CORREO_REDIRIGIR_A  MODO PRUEBA: si tiene un correo, TODOS los envíos llegan ahí.
# Dejar vacío solo cuando se vaya a enviar a los destinatarios reales.
correo.redirigir_a=tu_correo@upb.edu.co

# --- Firma digital y cifrado ---
# CT_FIRMA_P12_PASSWORD  clave del certificado Seguridad/certificado.p12
firma.p12.password=CLAVE_DEL_CERTIFICADO_P12
# CT_CIFRADO_CLAVE  frase de la que se deriva la clave AES de los archivos cifrados.
# Si ya hay archivos cifrados, debe ser la misma frase con la que se cifraron.
cifrado.clave=FRASE_LARGA_Y_SECRETA

# --- Certificado PDF ---
# Debajo de "Atentamente," va el usuario activo con rol Jefe de Nómina y este cargo (el del encabezado
# "EL SUSCRITO COORDINADOR DE NÓMINA"). El nombre de aquí solo se usa si no hay ningún Jefe de Nómina activo.
# CT_CERTIFICADO_FIRMANTE_NOMBRE
certificado.firmante.nombre=Jhon Jairo Andrés Aparicio Rueda
# CT_CERTIFICADO_FIRMANTE_CARGO
certificado.firmante.cargo=Coordinador de Nómina

# --- Inicio de sesión ---
# Contraseñas incorrectas seguidas antes de bloquear el usuario, y minutos que dura el bloqueo.
# El Administrador puede desbloquear antes desde Usuarios (también al asignar una contraseña nueva).
# Los usuarios con rol Administrador no se bloquean.
# CT_SEGURIDAD_LOGIN_INTENTOS / CT_SEGURIDAD_LOGIN_BLOQUEO_MINUTOS
seguridad.login.intentos=3
seguridad.login.bloqueo_minutos=15
# CT_SEGURIDAD_COOKIE_SEGURA  true en producción (HTTPS): la cookie de sesión solo viaja cifrada.
# En el PC con http://localhost dejar false, si no, no se puede iniciar sesión.
seguridad.cookie_segura=false

# --- Servidor web ---
# En el PC no hace falta cambiar nada (http://localhost:7000). En producción el aplicativo atiende
# https://certributario.bucaramanga.upb.edu.co en el 443 (ver ssl.* abajo y despliegue/).
# CT_SERVIDOR_HOST  interfaz donde escucha (0.0.0.0 = todas; 127.0.0.1 = solo el mismo servidor)
servidor.host=0.0.0.0
# CT_SERVIDOR_PUERTO
servidor.puerto=7000
# CT_SERVIDOR_URL  dirección con la que entran los usuarios (solo para los mensajes de la consola)
servidor.url=http://localhost:7000

# --- HTTPS directo en el aplicativo (producción) ---
# Si ssl.certificado y ssl.llave tienen valor, el aplicativo atiende https en ssl.puerto y el http de
# ssl.puerto_redireccion solo redirige a https (servidor.host/servidor.puerto ya no se usan).
# En el PC dejarlos vacíos. Valores del web14 en despliegue/config.produccion.properties
# CT_SSL_CERTIFICADO  certificado + cadena en un solo archivo PEM
ssl.certificado=
# CT_SSL_LLAVE
ssl.llave=
# CT_SSL_PUERTO
ssl.puerto=443
# CT_SSL_PUERTO_REDIRECCION  (0 = no abrir el puerto http)
ssl.puerto_redireccion=80
